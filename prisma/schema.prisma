generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AssignmentStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum AssignmentType {
  HOMEWORK
  TEST
  PROJECT
  READING
}

// Framework — qaysi sertifikat/kurs tizimiga moslashgan
enum Framework {
  IELTS
  CEFR
  TOEFL
  CAMBRIDGE
  DUOLINGO
  GENERAL
}

// Ko'nikma turi — har biri o'ziga mos topshirish interfeysi bilan
enum SkillType {
  WRITING
  SPEAKING
  READING
  LISTENING
  GRAMMAR
  VOCABULARY
  MIXED
  USE_OF_ENGLISH
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
}

enum NotificationType {
  NEW_ASSIGNMENT
  ASSIGNMENT_GRADED
  DEADLINE_REMINDER
  SUBMISSION_RECEIVED
  SYSTEM
}

// ─── VIDEO / LIVE LESSONS ─────────────────────────────────────────────────────

enum LessonStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveLesson {
  id          String       @id @default(cuid())
  teacherId   String
  title       String
  description String?
  scheduledAt DateTime
  duration    Int          @default(60)  // minutes
  roomUrl     String?                    // Daily.co meeting URL
  roomName    String?                    // Daily.co room name
  status      LessonStatus @default(SCHEDULED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  teacher User @relation("TeacherLessons", fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("live_lessons")
}

// ─── GAMIFICATION ─────────────────────────────────────────────────────────────

enum BadgeType {
  // Submission badges
  FIRST_STEP        // First submission
  SUBMISSIONS_10    // 10 submissions
  SUBMISSIONS_50    // 50 submissions
  // Score badges
  PERFECT_SCORE     // 100% on any assignment
  HIGH_ACHIEVER     // 90%+ score three times
  // Streak badges
  STREAK_3          // 3-day streak
  STREAK_7          // 7-day streak
  STREAK_30         // 30-day streak
  // Skill badges
  WRITING_PRO       // 5 writing assignments graded ≥70%
  READING_PRO       // 5 reading assignments graded ≥70%
  GRAMMAR_PRO       // 5 grammar assignments graded ≥70%
  // Level badges
  SCHOLAR           // Reach level 4
  MASTER            // Reach level 6
  LEGEND            // Reach level 8
  // Special
  EARLY_BIRD        // Submit 24h before deadline (3 times)
  SPEED_DEMON       // Submit within 1h of assignment creation
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?
  name          String
  role          Role      @default(STUDENT)
  avatar        String?
  phone         String?
  bio           String?
  timezone      String    @default("Asia/Tashkent")
  language      String    @default("uz")
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Gamification
  xp               Int       @default(0)
  level            Int       @default(1)
  streak           Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?

  assignmentsCreated    Assignment[]   @relation("TeacherAssignments")
  assignmentsFor        Assignment[]   @relation("StudentAssignments")
  submissions           Submission[]
  grades                Grade[]        @relation("TeacherGrades")
  notificationsReceived Notification[]
  sentMessages          Message[]      @relation("SentMessages")
  receivedMessages      Message[]      @relation("ReceivedMessages")
  teacherEnrollments    Enrollment[]   @relation("TeacherEnrollments")
  studentEnrollments    Enrollment[]   @relation("StudentEnrollments")
  uploadedFiles         File[]
  auditLogs             AuditLog[]
  userBadges            UserBadge[]
  xpLogs                XpLog[]
  taughtLessons         LiveLesson[] @relation("TeacherLessons")

  @@map("users")
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  badge     BadgeType
  earnedAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badge])
  @@map("user_badges")
}

model XpLog {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String   // e.g. "submission", "high_score", "streak"
  meta      Json?    // extra context (assignmentId, score, etc.)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("xp_logs")
}

model Enrollment {
  id        String    @id @default(cuid())
  studentId String
  teacherId String
  status    String    @default("ACTIVE")
  startDate DateTime  @default(now())
  endDate   DateTime?

  student User @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User @relation("TeacherEnrollments", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId])
  @@map("enrollments")
}

model Assignment {
  id                  String           @id @default(cuid())
  title               String
  description         String?
  instructions        String?
  dueDate             DateTime?
  maxScore            Int              @default(100)
  status              AssignmentStatus @default(DRAFT)
  type                AssignmentType   @default(HOMEWORK)
  // Framework: qaysi sertifikat/kurs tizimi (IELTS, CEFR, TOEFL...)
  framework           Framework        @default(GENERAL)
  // Level: framework-ga qarab (B2, 6.5, FCE, Intermediate...)
  level               String?
  // Ko'nikma turi — topshirish interfeysini belgilaydi
  skillType           SkillType        @default(WRITING)
  // Skill-specific content: savol, so'zlar, matn, audio link va h.k.
  skillContent        Json?
  teacherId           String
  studentId           String?
  allowLateSubmission Boolean          @default(false)
  attachments         Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  teacher     User         @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  student     User?        @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  // Skill-specific structured answers (MCQ, fill-in, vocab results)
  answers      Json?
  // Auto-calculated score for Reading, Listening, Grammar, Vocabulary
  autoScore    Float?
  fileUrls     String[]         @default([])
  audioUrl     String?
  videoUrl     String?
  status       SubmissionStatus @default(DRAFT)
  submittedAt  DateTime?
  isLate       Boolean          @default(false)
  attempt      Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade      Grade?

  @@map("submissions")
}

model Grade {
  id               String   @id @default(cuid())
  submissionId     String   @unique
  teacherId        String
  score            Float
  feedback         String?
  audioFeedbackUrl String?
  rubricScores     Json?
  gradedAt         DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacher    User       @relation("TeacherGrades", fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("grades")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model File {
  id         String   @id @default(cuid())
  url        String
  key        String
  name       String
  size       Int
  mimeType   String
  uploadedBy String
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("files")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
